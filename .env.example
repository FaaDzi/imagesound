# GEMINI_API_KEY: Required for the Gemini image-to-prompt step
# (pipeline/generate_song.py). Set this to your own Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE: Backend API URL consumed by the React frontend.
# Leave as-is for local dev. For remote tunnel access (`python run.py
# --tunnel`), this is set automatically to `/api` by run.py -- you don't
# need to edit it by hand for that.
VITE_API_BASE=http://localhost:8000

# ALLOWED_ORIGINS: Comma-separated list of frontend origins the backend will accept.
# Defaults to http://localhost:3000 (the React dev server port). No change
# is needed here for remote tunnel access -- the tunnel exposes a single
# origin (the frontend) with same-origin `/api` proxying to the backend, so
# there's no separate cross-origin tunnel URL that needs to be added here.
ALLOWED_ORIGINS=http://localhost:3000
