# GEMINI_API_KEY: Required for the Gemini image-to-prompt step
# (pipeline/generate_song.py). Set this to your own Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: which Gemini model reads the image. Optional -- the default is
# a pinned Lite model, chosen because the free tier's quota for the newest
# Flash models is small and the "-latest" aliases move onto them without
# notice. Set this only if you want to try another one, e.g. a full Flash
# model on a paid key, where the quota and the 503s stop mattering:
# GEMINI_MODEL=gemini-3.8-flash

# DESCRIBER_ORDER: which backends read the image, and in what order. The first
# one that answers wins; a backend that fails (quota, 503, not running) falls
# through to the next. Default keeps Gemini's quality as the normal path with
# the local model as a safety net, so a quota wall degrades the result instead
# of failing the request. Use "ollama" alone to go fully offline.
# DESCRIBER_ORDER=gemini,ollama

# OLLAMA_MODEL / OLLAMA_HOST: the local vision model and where Ollama listens.
# Weights are stored wherever OLLAMA_MODELS points -- that is an Ollama setting,
# not one this app reads, and it is set as a Windows user environment variable
# (here: D:\Other\Local LLM) so nothing lands on C:. Pull the model once with:
#   ollama pull gemma3:4b
# Pick a model that does NOT reason: a reasoning model spends its token budget
# deliberating and returns nothing (qwen3-vl:4b fails this way, 6 of 6).
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_HOST=http://127.0.0.1:11434

# OLLAMA_KEEP_ALIVE: how long the vision model stays in VRAM after answering.
# Ollama's default is 5 minutes, which would still be holding ~3GB of an 8GB
# card when music generation starts right afterwards. 60s covers a retry
# without overlapping the generation.
# OLLAMA_KEEP_ALIVE=60s

# OLLAMA_NUM_PREDICT: token budget for the local model's reply.
# OLLAMA_NUM_PREDICT=800

# VITE_API_BASE: Backend API URL consumed by the React frontend.
# Leave as-is for local dev. For remote tunnel access (`python run.py
# --tunnel`), this is set automatically to `/api` by run.py -- you don't
# need to edit it by hand for that.
VITE_API_BASE=http://localhost:8000

# ALLOWED_ORIGINS: Comma-separated list of frontend origins the backend will accept.
# Defaults to http://localhost:4000 (the React dev server port). No change
# is needed here for remote tunnel access -- the tunnel exposes a single
# origin (the frontend) with same-origin `/api` proxying to the backend, so
# there's no separate cross-origin tunnel URL that needs to be added here.
ALLOWED_ORIGINS=http://localhost:4000

# SESSION_SECRET_KEY: Required for the public tunnel (`python run.py`, the default). run.py refuses
# to start the tunnel unless this is set to a real random value at least 32
# characters long (the default dev secret is hardcoded in
# backend/app/config.py, so anyone could forge a valid login session and
# bypass the password gate if you tunneled with it).
# Generate one and put it in your own .env (never commit a real value here).
# Leave this line commented out to use the (local-dev-only) default -- do NOT
# uncomment it with an empty value, that would set an empty-string secret:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET_KEY=

# GIST_ID / GIST_TOKEN: let `run.py` publish the current public URL
# to a GitHub Gist that the status page (status-page/index.html) reads. The
# token must be a classic token with ONLY the `gist` scope -- it can edit your
# gists, nothing else. Keep it here in .env, never in a committed file.
# Leave both unset and the tunnel still works; the status page just goes stale.
# GIST_ID=
# GIST_TOKEN=
