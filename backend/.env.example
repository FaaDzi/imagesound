# Copy this file to .env and adjust values for your local setup.
# Neither this file nor .env should contain real secrets.

# Absolute or relative path to the SQLite database file.
# Default: backend/app.db (relative to the backend/ folder)
DATABASE_PATH=

# Absolute path to the root of the storage folders.
# Default: backend/storage/ (relative to the backend/ folder)
STORAGE_ROOT=
